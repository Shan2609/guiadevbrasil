void setup()
{
  Serial.begin(9600);
  mod.begin(4800);
  pinMode(RE, OUTPUT);
  pinMode(DE, OUTPUT);

  Blynk.begin(auth, ssid, pass, IPAddress(34,66,39,107), 8080);
  Blynk.syncAll();
  ArduinoOTA.setHostname("VASO");
  ArduinoOTA.begin();
 
  timer.setInterval(1000L, CO_CHECK);

  Wire.begin();
  scd4x.begin(Wire);
  
 error = scd4x.startPeriodicMeasurement();
}

void loop()
{
  Blynk.run();
        ArduinoOTA.handle();
    
   

    lastMillis = millis();
    Blynk.virtualWrite(V0, lastMillis/1000);
    
  val_moist = moisture();
////  memset(values1,0,sizeof(values1));
    Blynk.virtualWrite(V1, val_moist);
//delay(1000); 

  val_temp = temperatura();
     Blynk.virtualWrite(V2, val_temp);
//delay(1000);

  val_ec = ec_call();
   Blynk.virtualWrite(V3, val_ec);
//delay(1000);  

if ( LastMaxHumidity < val_moist )  { LastMaxHumidity = val_moist; }
  else {LastMaxHumidity = LastMaxHumidity;}

val_ec_adj = val_ec * ( 1 + ( LastMaxHumidity - val_moist ) / 100 );
   Blynk.virtualWrite(V14, val_ec_adj);

  val_ph = ph_call();
   Blynk.virtualWrite(V4, val_ph);

delay(1000);  

//  val_nitro = nitro_call();
//   Blynk.virtualWrite(V5, val_nitro);
////delay(1000);  
//
