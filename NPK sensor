//   Blynk.virtualWrite(V6, val_phos);
////delay(1000);  
//
//  val_pota = pota_call();
//   Blynk.virtualWrite(V7, val_pota);
//delay(1000);  

Blynk.virtualWrite(V13, err99);

delay(500);

error = scd4x.getDataReadyFlag(isDataReady);
    if (error) {
        Blynk.virtualWrite(V13, err1);
        return;
    }
    if (!isDataReady) {
        return;
    }
    error = scd4x.readMeasurement(co2, temperature, humidity);

    if (error) {
        Blynk.virtualWrite(V13, err2);
    } else if (co2 == 0) {
        Blynk.virtualWrite(V13, err3);
    } else {
      
      Blynk.virtualWrite(V10, co2);
      Blynk.virtualWrite(V11, temperature);
      Blynk.virtualWrite(V12, humidity);

    }

}



  
